# Dependencies
node_modules/
# Local npm cache (used when the default cache directory is not writable)
.npm-cache/

# Electron downloaded by scripts/ensure-electron.mjs into
# %LOCALAPPDATA%/dsh-quickdock/electron; never committed.
electron/

# Runtime artifacts
*.log
dock.log
host.log
diag.json
window.json

# Electron leftovers
default_app*.asar

# Windows reserved name: neither deletable nor committable
nul

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local Electron extraction used by the dev harness
.electron-test/

# Temporary debug output
scripts/_*
.playwright-mcp/
# One-off local verification scripts and screenshots (the Chrome profile may be
# locked by the OS, so it is not cleaned up)
tmp/
