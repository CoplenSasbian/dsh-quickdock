{
  "name": "dsh-quickdock",
  "version": "0.6.0-beta.4",
  "description": "QuickDock: a small always-on-top window around DSH's own Web UI, opened from a session header and pinned over other apps.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./service": {
      "default": "./service.js"
    },
    "./dock": {
      "default": "./dock.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "API.md",
    "runtime",
    "host",
    "locale",
    "scripts",
    "icon.svg"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check.mjs",
    "clean-dsh-cookies": "node scripts/clean-dsh-cookies.mjs",
    "verify": "node scripts/run-tests.mjs && node scripts/check.mjs",
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "lint": "eslint ."
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "dependencies": {
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0"
  },
  "optionalDependencies": {
    "electron": "44.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "electron",
    "dock",
    "always-on-top"
  ]
}
