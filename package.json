{
  "name": "dsh-quickdock",
  "version": "0.3.0",
  "description": "QuickDock: an always-available dock in the corner of the screen (composer + run log), opened from a DSH session header.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "web",
    "runtime",
    "host",
    "locale",
    "scripts",
    "icon.svg"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/run-tests.mjs && node scripts/check.mjs && node scripts/smoke.mjs",
    "dev": "node --import ./scripts/register-hook.mjs scripts/dev-harness.mjs",
    "ensure-electron": "node scripts/ensure-electron.mjs",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "dependencies": {
    "@electron/get": "^5.1.0",
    "@electron-internal/extract-zip": "^1.0.5"
  },
  "optionalDependencies": {
    "electron": "44.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "electron",
    "dock",
    "i18n"
  ],
  "devDependencies": {
    "eslint": "^9.14.0"
  }
}
